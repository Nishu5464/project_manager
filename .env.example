# Copy this to .env and fill in values
# Railway injects DATABASE_URL automatically — do not set it here for production

SECRET_KEY=your-secret-key-here-generate-with-python-c-import-secrets-secrets-token-hex-32
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.up.railway.app

# For local development (SQLite is used when DATABASE_URL is absent)
# DATABASE_URL=postgresql://user:password@localhost:5432/project_manager
